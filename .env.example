# Database Connection
# Example URL structure: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For Docker: postgresql://postgres:postgres@postgres:5432/postgres
# For Local Dev without Docker: postgresql://postgres:postgres@localhost:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Authentication & Ingestion
# Secret token for authenticating batch log ingestions from internal services
INGESTION_TOKEN="generate-a-secure-random-token-for-production"

# Webhook Secrets
# Format: INGEST_WEBHOOK_SECRET_<CHANNEL_ID>
INGEST_WEBHOOK_SECRET_GITHUB="your-github-webhook-secret-here"
INGEST_WEBHOOK_SECRET_STRIPE="your-stripe-webhook-secret-here"

# Vercel specifics
# You do not need to define these manually in Vercel if you use Vercel Postgres,
# but ensure DATABASE_URL, INGESTION_TOKEN, and INGEST_WEBHOOK_SECRET_* are set in the Vercel Dashboard.
