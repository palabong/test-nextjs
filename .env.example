# Database Connection
# Example URL structure: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Authentication & Ingestion
# Secret token for authenticating batch log ingestions from internal services
INGESTION_TOKEN="generate-a-secure-random-token-for-production"

# Webhook Secrets
# Format: INGEST_WEBHOOK_SECRET_<CHANNEL_ID>
INGEST_WEBHOOK_SECRET_GITHUB="your-github-webhook-secret-here"
INGEST_WEBHOOK_SECRET_STRIPE="your-stripe-webhook-secret-here"
